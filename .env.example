# SignalDesk AI Backend - local development environment

ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development
APP_ENV=local

# Service ports
GATEWAY_BFF_PORT=3000
NOTIFICATION_SERVICE_PORT=3001
SEARCH_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
IDENTITY_SERVICE_PORT=5001
WORKSPACE_SERVICE_PORT=5002
SUPPORT_SERVICE_PORT=5003
KNOWLEDGE_SERVICE_PORT=5004
CAMPAIGN_SERVICE_PORT=5005

# Service base URLs for host-run development
GATEWAY_BFF_URL=http://localhost:3000
NOTIFICATION_SERVICE_URL=http://localhost:3001
SEARCH_SERVICE_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:3003
IDENTITY_SERVICE_URL=http://localhost:5001
WORKSPACE_SERVICE_URL=http://localhost:5002
SUPPORT_SERVICE_URL=http://localhost:5003
KNOWLEDGE_SERVICE_URL=http://localhost:5004
CAMPAIGN_SERVICE_URL=http://localhost:5005

# PostgreSQL direct connection is for local debugging and migrations.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=signaldesk
POSTGRES_USER=signaldesk
POSTGRES_PASSWORD=signaldesk
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=signaldesk;Username=signaldesk;Password=signaldesk

# Application services should prefer PgBouncer for normal runtime DB access.
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_CONNECTION_STRING=Host=localhost;Port=6432;Database=signaldesk;Username=signaldesk;Password=signaldesk

# Container DNS names for services running inside Docker.
POSTGRES_DOCKER_HOST=postgres
PGBOUNCER_DOCKER_HOST=pgbouncer
MONGODB_DOCKER_HOST=mongodb
REDIS_DOCKER_HOST=redis
RABBITMQ_DOCKER_HOST=rabbitmq
ELASTICSEARCH_DOCKER_HOST=elasticsearch
MAILPIT_DOCKER_HOST=mailpit
OLLAMA_DOCKER_HOST=ollama

# MongoDB
MONGODB_DATABASE=signaldesk
MONGODB_URI=mongodb://localhost:27017/signaldesk
MONGODB_DOCKER_URI=mongodb://mongodb:27017/signaldesk

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_DOCKER_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=signaldesk
RABBITMQ_DEFAULT_PASS=signaldesk
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://signaldesk:signaldesk@localhost:5672
RABBITMQ_DOCKER_URL=amqp://signaldesk:signaldesk@rabbitmq:5672
RABBITMQ_DOMAIN_EVENTS_EXCHANGE=signaldesk.domain-events
RABBITMQ_DEAD_LETTER_EXCHANGE=signaldesk.domain-events.dlx
RABBITMQ_MAX_RETRY_COUNT=10
RABBITMQ_RETRY_DELAY_MS=30000

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_DOCKER_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=signaldesk

# Supabase Storage
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=signaldesk-attachments
SUPABASE_STORAGE_BUCKET_TEMP_UPLOADS=signaldesk-temp-uploads
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=900
SUPABASE_STORAGE_UPLOAD_URL_TTL_SECONDS=900

# Mailpit
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_DOCKER_HOST=mailpit
MAILPIT_UI_URL=http://localhost:8025
SMTP_FROM_EMAIL=no-reply@signaldesk.local
SMTP_FROM_NAME=SignalDesk Local

# Ollama local AI fallback
OLLAMA_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI is optional for local development. Leave empty unless AI service needs it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT / auth
JWT_ISSUER=signaldesk-identity
JWT_AUDIENCE=signaldesk-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem

# Gateway and security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:4200
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_AI_PER_MINUTE=60
REQUEST_BODY_LIMIT=2mb
FILE_UPLOAD_MAX_BYTES=10485760
GATEWAY_READY_CHECK_DOWNSTREAMS=false

# Observability
OTEL_SERVICE_NAME=signaldesk-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_UI_URL=http://localhost:16686
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3009
LOKI_URL=http://localhost:3100
LOG_LEVEL=debug
